{
  "name": "digest-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Personal triage agent — Electron app hosting a SQLite cognitive substrate, event bus, and spawned Claude Code subprocesses for cognition and execution.",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "start:test": "npm run build && bash scripts/start-test.sh",
    "debug:tools": "node scripts/diag-substrate-tools.mjs",
    "eval": "node --env-file=.env.testmode --experimental-strip-types --no-warnings scripts/eval-digest.ts",
    "regen:prompts": "node --experimental-strip-types --no-warnings scripts/regen-prompts.ts",
    "prebuild": "npm run regen:prompts",
    "test": "npm run rebuild:node --silent && vitest run; e=$?; npm run rebuild:electron --silent; exit $e",
    "test:watch": "npm run rebuild:node --silent && vitest",
    "rebuild:node": "npm rebuild better-sqlite3 --update-binary --build-from-source >/dev/null 2>&1 || npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 --silent >/dev/null 2>&1 || electron-rebuild -f -w better-sqlite3",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "clean": "rm -rf dist release",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:dir": "npm run build && electron-builder --mac --dir",
    "postinstall": "electron-rebuild --force"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@blackglory/better-sqlite3-migrations": "^0.2.0",
    "@langfuse/otel": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "better-sqlite3": "^11.3.0",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.1.0",
    "jsonc-parser": "^3.3.1",
    "nanoid": "^5.0.9",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
