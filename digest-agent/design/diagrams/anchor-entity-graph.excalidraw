    {"type":"text","id":"slow_t","x":110,"y":275,"width":480,"height":70,"text":"SLOW LAYER  ·  precision 0.95\nPartner at IPV. Series A lead. Met April 2025. Direct, terms-focused.\n6h reply median on weekdays.","originalText":"SLOW LAYER  ·  precision 0.95\nPartner at IPV. Series A lead. Met April 2025. Direct, terms-focused.\n6h reply median on weekdays.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"middle","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400003,"version":1,"versionNonce":400004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"slow_layer","lineHeight":1.4},
