    {"type":"text","id":"entity_rels_t","x":1210,"y":425,"width":440,"height":135,"text":"RELATIONSHIPS  (layered, per-layer precision)\n\n→ anchor:marcus_webb  ·  works_with\n  slow: \"Sarah works with Marcus at IPV\"      p=0.6\n  mid:  \"On Tessera Series A diligence\"        p=0.78\n  fast: \"Cc'd on Marcus's reply today\"           p=0.95\n\n→ anchor:series_a_raise  ·  involved_in","originalText":"RELATIONSHIPS  (layered, per-layer precision)\n\n→ anchor:marcus_webb  ·  works_with\n  slow: \"Sarah works with Marcus at IPV\"      p=0.6\n  mid:  \"On Tessera Series A diligence\"        p=0.78\n  fast: \"Cc'd on Marcus's reply today\"           p=0.95\n\n→ anchor:series_a_raise  ·  involved_in","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":710003,"version":1,"versionNonce":710004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"entity_rels","lineHeight":1.4},
