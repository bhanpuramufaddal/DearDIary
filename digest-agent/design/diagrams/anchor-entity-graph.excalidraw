    {"type":"text","id":"entity_notes_t","x":1210,"y":300,"width":440,"height":90,"text":"NOTES (free-form)\n\nAppears as cc on two Marcus threads about cap table.\nVertex.com matches a fund in the Series A pipeline.\nHasn't emailed Avery directly. Probably IPV colleague\nor competing fund associate.","originalText":"NOTES (free-form)\n\nAppears as cc on two Marcus threads about cap table.\nVertex.com matches a fund in the Series A pipeline.\nHasn't emailed Avery directly. Probably IPV colleague\nor competing fund associate.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":700003,"version":1,"versionNonce":700004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"entity_notes","lineHeight":1.4},
