    {"type":"text","id":"world_body","x":1115,"y":550,"width":350,"height":125,"text":"Gmail Sent folder · Calendar state · Notes content · ...\n\nthe record of action.\nno separate action-log inside the tool —\nthe world holds it.\n\nactions taken on the world become observable\nat the next event the daemon picks up.","originalText":"Gmail Sent folder · Calendar state · Notes content · ...\n\nthe record of action.\nno separate action-log inside the tool —\nthe world holds it.\n\nactions taken on the world become observable\nat the next event the daemon picks up.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":600005,"version":1,"versionNonce":600006,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.45},
