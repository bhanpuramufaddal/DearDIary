    {"type":"text","id":"title","x":60,"y":30,"width":1200,"height":40,"text":"Execution Surfaces","originalText":"Execution Surfaces","fontSize":28,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100001,"version":1,"versionNonce":100002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":60,"y":75,"width":1700,"height":24,"text":"Primary UI is the Electron diary view (journal-styled, HITL templates). Surface MCP plugin exposes 5 tools to Claude Code as a secondary surface. The diary persists in SQLite (digest.db) and assembles to A2UI JSON for renderers.","originalText":"Primary UI is the Electron diary view (journal-styled, HITL templates). Surface MCP plugin exposes 5 tools to Claude Code as a secondary surface. The diary persists in SQLite (digest.db) and assembles to A2UI JSON for renderers.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100003,"version":1,"versionNonce":100004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
