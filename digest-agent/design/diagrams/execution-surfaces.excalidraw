    {"type":"text","id":"diary_content_t","x":635,"y":275,"width":330,"height":295,"text":"{\n  \"date\": \"2026-05-25\",\n  \"sections\": [\n    {\n      \"id\": \"on-the-desk\",\n      \"components\": [\n        {\n          \"id\": \"comp_001\",\n          \"type\": \"email-draft\",\n          \"anchor_refs\": [\"renee_tan\"],\n          \"content\": { ... },\n          \"actions\": [\n            {\"name\": \"Send\", \"kind\": \"email_send\"},\n            {\"name\": \"Edit\"},\n            {\"name\": \"Discard\"}\n          ],\n          \"status\": \"open\",\n          \"comments\": [],\n          \"efference_prediction\": { ... }\n        }\n      ]\n    }, ...\n  ],\n  \"notes\": [...],\n  \"thinking_layer\": [...]\n}","originalText":"{\n  \"date\": \"2026-05-25\",\n  \"sections\": [\n    {\n      \"id\": \"on-the-desk\",\n      \"components\": [\n        {\n          \"id\": \"comp_001\",\n          \"type\": \"email-draft\",\n          \"anchor_refs\": [\"renee_tan\"],\n          \"content\": { ... },\n          \"actions\": [\n            {\"name\": \"Send\", \"kind\": \"email_send\"},\n            {\"name\": \"Edit\"},\n            {\"name\": \"Discard\"}\n          ],\n          \"status\": \"open\",\n          \"comments\": [],\n          \"efference_prediction\": { ... }\n        }\n      ]\n    }, ...\n  ],\n  \"notes\": [...],\n  \"thinking_layer\": [...]\n}","fontSize":10,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200009,"version":1,"versionNonce":200010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"diary_content","lineHeight":1.4},
