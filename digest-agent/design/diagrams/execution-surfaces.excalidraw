    {"type":"text","id":"mcp_h","x":95,"y":435,"width":370,"height":28,"text":"MCP Plugin Surface","originalText":"MCP Plugin Surface","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#6d28d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400003,"version":1,"versionNonce":400004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"mcp_tools","x":95,"y":470,"width":370,"height":200,"text":"5 typed tools, all returning structured data:\n\n• digest_run(force=false)\n   → fire diary tick, return new diary JSON\n• digest_get(date=null)\n   → return latest or specified diary JSON\n• diary_act(component_id, action_kind, result)\n   → calling agent confirms action ran;\n     updates component status\n• diary_add_comment(component_id, text)\n   → principal-authored comment → stream entry\n• diary_add_note(text)\n   → principal-authored bottom note → stream entry","originalText":"5 typed tools, all returning structured data:\n\n• digest_run(force=false)\n   → fire diary tick, return new diary JSON\n• digest_get(date=null)\n   → return latest or specified diary JSON\n• diary_act(component_id, action_kind, result)\n   → calling agent confirms action ran;\n     updates component status\n• diary_add_comment(component_id, text)\n   → principal-authored comment → stream entry\n• diary_add_note(text)\n   → principal-authored bottom note → stream entry","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400005,"version":1,"versionNonce":400006,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.45},
    {"type":"arrow","id":"arrow_mcp_diary","x":482,"y":500,"width":116,"height":-100,"strokeColor":"#6d28d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1.5,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":410001,"version":1,"versionNonce":410002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"points":[[0,0],[116,-100]],"startBinding":{"elementId":"mcp","focus":0,"gap":2},"endBinding":{"elementId":"diary_central","focus":0,"gap":2},"startArrowhead":null,"endArrowhead":"arrow"},
    {"type":"text","id":"mcp_read_label","x":500,"y":480,"width":120,"height":18,"text":"reads / writes","originalText":"reads / writes","fontSize":11,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":410003,"version":1,"versionNonce":410004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
