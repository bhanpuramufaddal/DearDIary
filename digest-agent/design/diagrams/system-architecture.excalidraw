    {"type":"text","id":"cc_t","x":1610,"y":190,"width":200,"height":130,"text":"Electron renderer  (PRIMARY UI)\n+ Claude Code MCP plugin\n\nDiary window renders A2UI via\nHITL template library;\nactions emit task.fired →\nexecution Claude Code subprocess\nposts comments + notes via IPC /\nsurface MCP","originalText":"Electron renderer  (PRIMARY UI)\n+ Claude Code MCP plugin\n\nDiary window renders A2UI via\nHITL template library;\nactions emit task.fired →\nexecution Claude Code subprocess\nposts comments + notes via IPC /\nsurface MCP","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1e3a5f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":800003,"version":1,"versionNonce":800004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"claude_code","lineHeight":1.3},
