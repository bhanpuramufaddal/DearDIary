    {"type":"text","id":"key_principle","x":80,"y":580,"width":1700,"height":70,"text":"PRINCIPLES  ·  no stream queue (events are triggers; cognitive state is memory)  ·  no backfill (agent queries MCP on demand for history)\n                       case_base cites source IDs directly (gmail:msg_abc, gcal:event_xyz, notion:page_123)  ·  mind dispatcher serializes invocations on the event bus","originalText":"PRINCIPLES  ·  no stream queue (events are triggers; cognitive state is memory)  ·  no backfill (agent queries MCP on demand for history)\n                       case_base cites source IDs directly (gmail:msg_abc, gcal:event_xyz, notion:page_123)  ·  mind dispatcher serializes invocations on the event bus","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":900001,"version":1,"versionNonce":900002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.5}
