    {"type":"text","id":"title","x":60,"y":30,"width":1400,"height":40,"text":"Cycle — three cognitive agents + execution lane","originalText":"Cycle — three cognitive agents + execution lane","fontSize":28,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100001,"version":1,"versionNonce":100002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":60,"y":75,"width":1700,"height":24,"text":"All agent loops are Claude Code subprocesses in permissionless mode. Mind: event-triggered, serialized. Diary: scheduled or on-demand, after mind queue drains. Cold-start: one-shot at init + on profile.md change. Execution (4th lane): spawned per task.fired; acts on the world; emits task.completed/failed back to mind.","originalText":"All agent loops are Claude Code subprocesses in permissionless mode. Mind: event-triggered, serialized. Diary: scheduled or on-demand, after mind queue drains. Cold-start: one-shot at init + on profile.md change. Execution (4th lane): spawned per task.fired; acts on the world; emits task.completed/failed back to mind.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100003,"version":1,"versionNonce":100004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
