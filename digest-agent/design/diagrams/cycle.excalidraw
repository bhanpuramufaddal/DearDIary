    {"type":"text","id":"diary_trigger","x":635,"y":280,"width":490,"height":24,"text":"trigger: schedule.diary_tick or digest_run; diary dispatcher spawns Claude Code (after mind queue empty)","originalText":"trigger: schedule.diary_tick or digest_run; diary dispatcher spawns Claude Code (after mind queue empty)","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":400005,"version":1,"versionNonce":400006,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"lineHeight":1.25},
