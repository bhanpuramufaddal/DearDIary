      }
    },
    {
      "type": "text",
      "id": "internal_scaffolding_txt",
      "x": 1365,
      "y": 3466,
      "width": 1135,
      "height": 290,
      "text": "INTERNAL SCAFFOLDING  (digest agent does NOT see; lives in persona-generator's working dir)\n\n  data/personas/<slug>/\n    persona.db                   \u2190 SQLite, the structured spine\n      \u251c personas, cast\n      \u251c storylines, declared_moments, moment_supporting_artifacts\n      \u251c noise_events, noise_effects, planned_artifacts\n      \u251c emails, email_attachments, email_threads, notes\n      \u251c initial_calendar_events, calendar_ops\n      \u251c validation_log\n      \u2514 agent_runs, agent_tool_calls, llm_calls  (observability)\n    activity_log.md              \u2190 35-day journal (spine, prose)\n    internal/                    \u2190 prose only\n      persona_origin.md\n      life_context.md\n      character_sketch.md        \u2190 back-stage truth\n      judgment.md                \u2190 operational essay\n      cast.md                    \u2190 P0\u2013P1 multi-paragraph profiles\n      day_archetypes.md\n      channels.md\n      window_plan.md\n      storylines/<id>/arc.md     \u2190 narrative arc per storyline\n      daily_state/day_NN.md      \u2190 35 journal entries\n    ideal_digests/morning_NN.json  \u2190 eval ground truth (30 files; Stage 9b output)\n    .langgraph_checkpoint.db     \u2190 pipeline orchestration state (separate DB)",
      "originalText": "INTERNAL SCAFFOLDING  (digest agent does NOT see; lives in persona-generator's working dir)\n\n  data/personas/<slug>/\n    persona.db                   \u2190 SQLite, the structured spine\n      \u251c personas, cast\n      \u251c storylines, declared_moments, moment_supporting_artifacts\n      \u251c noise_events, noise_effects, planned_artifacts\n      \u251c emails, email_attachments, email_threads, notes\n      \u251c initial_calendar_events, calendar_ops\n      \u251c validation_log\n      \u2514 agent_runs, agent_tool_calls, llm_calls  (observability)\n    activity_log.md              \u2190 35-day journal (spine, prose)\n    internal/                    \u2190 prose only\n      persona_origin.md\n      life_context.md\n      character_sketch.md        \u2190 back-stage truth\n      judgment.md                \u2190 operational essay\n      cast.md                    \u2190 P0\u2013P1 multi-paragraph profiles\n      day_archetypes.md\n      channels.md\n      window_plan.md\n      storylines/<id>/arc.md     \u2190 narrative arc per storyline\n      daily_state/day_NN.md      \u2190 35 journal entries\n    ideal_digests/morning_NN.json  \u2190 eval ground truth (30 files; Stage 9b output)\n    .langgraph_checkpoint.db     \u2190 pipeline orchestration state (separate DB)",
