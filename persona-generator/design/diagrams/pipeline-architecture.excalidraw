    {
      "type": "text",
      "id": "subtitle",
      "x": 700,
      "y": 88,
      "width": 1200,
      "height": 25,
      "text": "Reasoning-trace-first \u00b7 agent-loop as default \u00b7 10 stages \u00b7 6 phases \u00b7 35-day window (5 warm-up + 30 eval)",
      "originalText": "Reasoning-trace-first \u00b7 agent-loop as default \u00b7 10 stages \u00b7 6 phases \u00b7 35-day window (5 warm-up + 30 eval)",
      "fontSize": 16,
      "fontFamily": 3,
