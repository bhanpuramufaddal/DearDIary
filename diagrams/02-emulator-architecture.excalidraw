    {"type":"text","id":"vault_text","x":90,"y":195,"width":240,"height":310,"text":"THE SAFE\n\npersona.db\n(one SQLite file)\n\n253 emails\n55 notes\n24 calendar ops\n19 standing meetings\n8 storylines\n90 morning items\n\nEvery row has a fake\ntimestamp like\n2026-05-21T07:42-07:00\n— the digest agent\ntreats it as real","originalText":"THE SAFE\n\npersona.db\n(one SQLite file)\n\n253 emails\n55 notes\n24 calendar ops\n19 standing meetings\n8 storylines\n90 morning items\n\nEvery row has a fake\ntimestamp like\n2026-05-21T07:42-07:00\n— the digest agent\ntreats it as real","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#064e3b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":210002,"version":1,"versionNonce":210002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"vault","lineHeight":1.3},

