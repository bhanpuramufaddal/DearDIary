    {"type":"text","id":"clock_label_bottom","x":700,"y":445,"width":260,"height":20,"text":"7:00 AM · Tue · May 21","originalText":"7:00 AM · Tue · May 21","fontSize":14,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":220007,"version":1,"versionNonce":220007,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"text","id":"emulator_body","x":640,"y":485,"width":380,"height":100,"text":"reads the safe, filters every row\nto timestamps ≤ \"as of\",\nserves it on demand","originalText":"reads the safe, filters every row\nto timestamps ≤ \"as of\",\nserves it on demand","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#ffffff","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":220008,"version":1,"versionNonce":220008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.3},

    {"type":"rectangle","id":"agent","x":1320,"y":260,"width":260,"height":260,"strokeColor":"#6d28d9","backgroundColor":"#ddd6fe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":230001,"version":1,"versionNonce":230001,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"agent_text","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"agent_text","x":1330,"y":275,"width":240,"height":230,"text":"THE DIGEST AGENT\n\n(the consumer\nbeing evaluated)\n\nasks the emulator:\n\n\"as of this morning,\nshow me what's\nin Avery's inbox,\ncalendar, notes —\nthen ping me\nas new things arrive\nin the replay\"","originalText":"THE DIGEST AGENT\n\n(the consumer\nbeing evaluated)\n\nasks the emulator:\n\n\"as of this morning,\nshow me what's\nin Avery's inbox,\ncalendar, notes —\nthen ping me\nas new things arrive\nin the replay\"","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#4c1d95","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":230002,"version":1,"versionNonce":230002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"agent","lineHeight":1.3},

