    {"type":"text","id":"title","x":480,"y":40,"width":1080,"height":36,"text":"Service Emulator — replay any morning of a 35-day synthetic life","originalText":"Service Emulator — replay any morning of a 35-day synthetic life","fontSize":28,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200001,"version":1,"versionNonce":200001,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"text","id":"subtitle","x":480,"y":88,"width":1080,"height":24,"text":"turn the dial to any moment in the window — the digest agent sees exactly what would be visible at that time","originalText":"turn the dial to any moment in the window — the digest agent sees exactly what would be visible at that time","fontSize":15,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":200002,"version":1,"versionNonce":200002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

