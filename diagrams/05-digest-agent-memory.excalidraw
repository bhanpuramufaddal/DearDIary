    {"type":"text","id":"play_text","x":785,"y":555,"width":1000,"height":130,"text":"\"when an investor asks the same question twice → bump it to P0; they're not patient\"\n\"when a meeting moves → check whether the prep that depends on it also needs to move\"\n\"when Sam mentions a body thing twice → surface it; Avery underreacts to health\"\n\"when Wren's school sends a notice → never bury it; Avery has missed two before\"","originalText":"\"when an investor asks the same question twice → bump it to P0; they're not patient\"\n\"when a meeting moves → check whether the prep that depends on it also needs to move\"\n\"when Sam mentions a body thing twice → surface it; Avery underreacts to health\"\n\"when Wren's school sends a notice → never bury it; Avery has missed two before\"","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#6b21a8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":551004,"version":1,"versionNonce":551004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.7},
