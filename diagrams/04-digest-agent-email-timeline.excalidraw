    {"type":"text","id":"phone_text","x":1680,"y":400,"width":240,"height":320,"text":"📱 Tue 7:30 AM\n\nAvery's brief\n\n──────────────\nONE THING\nReply to Mary @ Bessemer\nbefore EOD: Q1 cohort cuts.\nShe asked twice.\n[draft reply ready]\n──────────────\nCALENDAR\nMove Thu working session\nto Fri — Mary's request.\n[accept] [propose new time]\n──────────────\nAWARENESS\nCustomer issue (Naveen)\ncan wait — Wed check-in.","originalText":"📱 Tue 7:30 AM\n\nAvery's brief\n\n──────────────\nONE THING\nReply to Mary @ Bessemer\nbefore EOD: Q1 cohort cuts.\nShe asked twice.\n[draft reply ready]\n──────────────\nCALENDAR\nMove Thu working session\nto Fri — Mary's request.\n[accept] [propose new time]\n──────────────\nAWARENESS\nCustomer issue (Naveen)\ncan wait — Wed check-in.","fontSize":11,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#064e3b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":450002,"version":1,"versionNonce":450002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"phone","lineHeight":1.3},

