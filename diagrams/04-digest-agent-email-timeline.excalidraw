    {"type":"text","id":"callout_text","x":150,"y":870,"width":1770,"height":40,"text":"The Watcher reacts to every event in real time; the Briefer thinks once a day. That's the trick: real-time bookkeeping + once-a-day judgment.","originalText":"The Watcher reacts to every event in real time; the Briefer thinks once a day. That's the trick: real-time bookkeeping + once-a-day judgment.","fontSize":14,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":500002,"version":1,"versionNonce":500002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"callout","lineHeight":1.4}
