    {"type":"text","id":"briefer_text","x":1390,"y":190,"width":260,"height":180,"text":"☀️  MORNING BRIEFER\n(daily at 7:00 AM)\n\nwakes up once a day\n\nreads the notebook\nend to end · writes\ntoday's brief · drafts\nreplies you might send","originalText":"☀️  MORNING BRIEFER\n(daily at 7:00 AM)\n\nwakes up once a day\n\nreads the notebook\nend to end · writes\ntoday's brief · drafts\nreplies you might send","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":320004,"version":1,"versionNonce":320004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"briefer","lineHeight":1.3},

