    {"type":"text","id":"s2_text","x":520,"y":322,"width":130,"height":135,"text":"🧠  2\n\nBuild\nthe inside\n\nbackstory,\nvoice, how\nthey decide","originalText":"🧠  2\n\nBuild\nthe inside\n\nbackstory,\nvoice, how\nthey decide","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#155e75","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130004,"version":1,"versionNonce":130004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"s2","lineHeight":1.3},

    {"type":"rectangle","id":"s3","x":680,"y":310,"width":150,"height":150,"strokeColor":"#be185d","backgroundColor":"#fce7f3","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":130005,"version":1,"versionNonce":130005,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"s3_text","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"s3_text","x":690,"y":322,"width":130,"height":135,"text":"👥  3\n\nCast\nthe people\n\nboss, co-founder,\nkid's teacher,\nmom","originalText":"👥  3\n\nCast\nthe people\n\nboss, co-founder,\nkid's teacher,\nmom","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#9d174d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130006,"version":1,"versionNonce":130006,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"s3","lineHeight":1.3},

