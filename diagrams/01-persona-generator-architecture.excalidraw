    {"type":"text","id":"input_label","x":70,"y":205,"width":220,"height":230,"text":"INPUT\n\nA short prompt:\n\n\"Avery Chen is the\nfounder/CEO of a\n12-person SaaS\ncompany in Oakland.\nShe lives with her\npartner Sam and\ntheir daughter Wren.\nThe next 35 days\nspan an active\nSeries A raise.\"","originalText":"INPUT\n\nA short prompt:\n\n\"Avery Chen is the\nfounder/CEO of a\n12-person SaaS\ncompany in Oakland.\nShe lives with her\npartner Sam and\ntheir daughter Wren.\nThe next 35 days\nspan an active\nSeries A raise.\"","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110002,"version":1,"versionNonce":110002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"input_box","lineHeight":1.3},

