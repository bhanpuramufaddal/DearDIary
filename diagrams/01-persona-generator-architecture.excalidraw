    {"type":"text","id":"s4_text","x":860,"y":322,"width":130,"height":135,"text":"⏰  4\n\nSet\nthe rhythm\n\nwhat Tuesday\nlooks like, which\nchannels matter","originalText":"⏰  4\n\nSet\nthe rhythm\n\nwhat Tuesday\nlooks like, which\nchannels matter","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130008,"version":1,"versionNonce":130008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"s4","lineHeight":1.3},

    {"type":"rectangle","id":"s5","x":1020,"y":310,"width":150,"height":150,"strokeColor":"#6d28d9","backgroundColor":"#ddd6fe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":130009,"version":1,"versionNonce":130009,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"s5_text","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"s5_text","x":1030,"y":322,"width":130,"height":135,"text":"📋  5\n\nPlan storylines\n\nthe raise, board,\nkid's school —\n5–10 parallel arcs","originalText":"📋  5\n\nPlan storylines\n\nthe raise, board,\nkid's school —\n5–10 parallel arcs","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#4c1d95","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130010,"version":1,"versionNonce":130010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"s5","lineHeight":1.3},

    {"type":"rectangle","id":"s6","x":1190,"y":310,"width":150,"height":150,"strokeColor":"#1e3a5f","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":130011,"version":1,"versionNonce":130011,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"s6_text","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"s6_text","x":1200,"y":322,"width":130,"height":135,"text":"📨  6\n\nLive every day\n\n35 days of\nactual emails,\nnotes, calendar\ninvites","originalText":"📨  6\n\nLive every day\n\n35 days of\nactual emails,\nnotes, calendar\ninvites","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1e3a5f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130012,"version":1,"versionNonce":130012,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"s6","lineHeight":1.3},

    {"type":"rectangle","id":"s7","x":1360,"y":310,"width":150,"height":150,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":130013,"version":1,"versionNonce":130013,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"s7_text","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"s7_text","x":1370,"y":322,"width":130,"height":135,"text":"✅  7\n\nCheck the work\n\npressure-test\nevery item;\ndrop the bad,\nfix the rest","originalText":"✅  7\n\nCheck the work\n\npressure-test\nevery item;\ndrop the bad,\nfix the rest","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#064e3b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":130014,"version":1,"versionNonce":130014,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"s7","lineHeight":1.3},

