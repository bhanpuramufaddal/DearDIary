    {"type":"text","id":"output_label","x":1570,"y":205,"width":260,"height":310,"text":"OUTPUT\n\nOne folder per persona:\n\npersona.db\n  • 8 storylines\n  • 90 morning items\n  • 253 emails\n  • 55 notes\n  • 24 calendar ops\n\nprofile.md\nactivity_log.md\n\nideal_digests/\n  morning_06 ... 35\n  (30 answer-key\n  JSON files)","originalText":"OUTPUT\n\nOne folder per persona:\n\npersona.db\n  • 8 storylines\n  • 90 morning items\n  • 253 emails\n  • 55 notes\n  • 24 calendar ops\n\nprofile.md\nactivity_log.md\n\nideal_digests/\n  morning_06 ... 35\n  (30 answer-key\n  JSON files)","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#064e3b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":140002,"version":1,"versionNonce":140002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"output_box","lineHeight":1.3},

